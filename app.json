{
  "expo": {
    "name": "WifeApp",
    "slug": "wifeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wifeapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8F4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wifeapp.control",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.wifeapp.control",
      "adaptiveIcon": {
        "backgroundColor": "#1B4D3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "QUERY_ALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "wifeapp",
              "host": "gate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "http://localhost:8081",
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F4"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1B4D3E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WifeApp usa la foto solo como avatar de tu pareja, en este teléfono.",
          "cameraPermission": "WifeApp usa la cámara solo para la foto del avatar.",
          "microphonePermission": false
        }
      ],
      "./plugins/withAppGate.js",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "http://localhost:8081",
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
      },
      "eas": {
        "projectId": "67834e29-6eb0-4ef0-8242-f1f85c8d20a4"
      }
    }
  }
}
